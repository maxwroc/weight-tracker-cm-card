{
  "name": "weight-tracker-cm-card",
  "version": "0.0.0",
  "description": "Home Assistant Lovelace card for tracking weight against a target, powered by the Custom Metrics integration",
  "type": "module",
  "module": "dist/weight-tracker-cm-card.js",
  "author": "Max Chodorowski",
  "license": "MIT",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "lovelace",
    "custom-cards",
    "weight",
    "custom-metrics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maxwroc/weight-tracker-cm-card.git"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "happy-dom": "^15.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.3.0",
    "rollup": "^4.20.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
